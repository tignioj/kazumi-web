# 复制为 .env 后按需修改；所有值均为默认值或留空使用内置默认值。
# 第一部分由 compose.yaml 自动读取，修改后执行 docker compose up -d。
# 后两部分默认注释；取消注释仅表示写入 .env，生效方式见各节和 README。
# 布尔值使用小写 true/false；带空格的值使用引号。
# npm run dev / npm start 不自动加载 .env，可分别使用：
# node --env-file=.env scripts/dev.mjs
# node --env-file=.env server/index.js
# npm run metadata:update / npm run check:ech 会自动加载 .env。

# === Compose 常用配置 ===

# 宿主机监听地址：0.0.0.0 允许局域网访问，127.0.0.1 仅本机访问。
HOST_BIND=0.0.0.0
# 宿主机访问端口；容器内部固定使用 3000。本地 npm start 则用作 Node 监听端口。
PORT=3000

# 元数据：local 查询本地 Bangumi 官方归档，remote 使用远程接口。
METADATA_MODE=local
# local 模式下首次启动自动下载归档并定期检查更新；false 仍允许手动更新。
METADATA_AUTO_UPDATE=true
# 自动检查间隔（小时，1–720）；更新失败后 15 分钟重试。
METADATA_UPDATE_INTERVAL_HOURS=24

# Bangumi 评论：缓存有效时间（分钟，大于 0），过期后重新获取，失败时读取旧缓存。
COMMENTS_CACHE_TTL_MINUTES=30
# 评论缓存内容容量（字节，默认 50 MiB，大于 0），自动淘汰最早更新的内容。
COMMENTS_CACHE_MAX_BYTES=52428800

# 视频缓存总容量（GiB，支持小数，例如 1.5，必须大于 0）；不会自动删除已有缓存。
VIDEO_CACHE_MAX_GB=10
# 图片磁盘缓存总容量（字节，默认 5 GiB）；0 关闭图片磁盘缓存。
IMAGE_CACHE_MAX_BYTES=5368709120

# 可选 DNS JSON 查询端点；留空使用系统 DNS，仍校验解析结果为公网地址。
# 使用 TUN/Fake-IP DNS 时可设为 https://1.1.1.1/dns-query。
DNS_OVER_HTTPS_URL=

# 动态播放器和验证码使用按需启动的 Chromium；Docker 镜像已包含浏览器。
# 本地开发先执行 npx playwright install chromium。

# === 其他服务端配置（Compose 不自动从 .env 传入） ===
# 本地运行：取消注释并通过进程环境变量或上述 --env-file 命令加载。
# Docker：还需在 compose.override.yaml 或 compose.yaml 的 environment 显式传入；
# 示例见 README「配置」。HOST / DATA_DIR / ALLOW_PRIVATE_NETWORK 在 Compose 中固定。

# Node 监听地址，默认 0.0.0.0；Docker 的宿主机监听地址使用 HOST_BIND。
# HOST=0.0.0.0
# 持久化数据目录，默认项目根目录下的 data；相对路径按进程工作目录解析。
# 包含规则、收藏、观看记录、播放进度、图片、视频缓存、元数据库和评论缓存。
# Docker 固定为 /app/data，并挂载 kazumi-data 数据卷。
# DATA_DIR=./data

# 归档版本清单地址，需返回包含 ZIP URL、大小、名称和 SHA-256 的官方格式 JSON。
# METADATA_ARCHIVE_MANIFEST_URL=https://raw.githubusercontent.com/bangumi/Archive/master/aux/latest.json
# Bangumi API 基址，主要用于 remote 元数据模式。
# BANGUMI_API_URL=https://api.bgm.tv
# Bangumi Next API 基址，用于评论、remote 元数据模式和本地模式下的封面地址查询。
# BANGUMI_NEXT_URL=https://next.bgm.tv
# 元数据和评论服务请求 Bangumi 时使用的 User-Agent，不影响片源请求或封面地址查询。
# BANGUMI_USER_AGENT="KazumiWeb/1.0 (self-hosted; https://github.com/Predidit/Kazumi)"
# 规则目录和 JSON 文件的基址，目录下需提供 index.json 和对应规则文件。
# RULES_REPOSITORY=https://raw.githubusercontent.com/Predidit/KazumiRules/main/

# 是否允许服务端请求本机、私网和保留地址；仅可信内网源或隔离测试环境按需开启。
# Compose 固定为 false，修改此处不会解除容器的私网访问限制。
# ALLOW_PRIVATE_NETWORK=false
# 媒体代理 URL 签名密钥；留空或不设置时，每次启动随机生成，无需手动填写。
# 如需固定值，请自行生成随机密钥，例如 node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"。
# 固定密钥不会持久化动态媒体会话，重启后仍需重新打开剧集；它不是登录密码。
# MEDIA_SECRET=
# Chromium 无活动任务后的回收时间（毫秒，默认 30000）；Cookie 会话保留在 Node 内存中。
# BROWSER_IDLE_TIMEOUT_MS=30000

# === 本地开发与测试（不传入 Compose 容器） ===
# npm run dev / npm run smoke / npm run test:e2e 不自动加载 .env，需通过进程环境传入。
# 开发前后端统一使用的 API 端口；npm run dev 使用此值，并覆盖 PORT，前端仍为 5173。
# API_PORT=3000
# npm run smoke 检查的实例地址，例如 BASE_URL=http://localhost:8080 npm run smoke。
# BASE_URL=http://localhost:3000
# true 让 smoke 额外检查实际番剧资料和规则仓库，需准备好元数据及上游网络。
# SMOKE_LIVE=false
# Playwright 测试应用端口；测试使用临时数据目录，与实际部署数据无关。
# E2E_PORT=4173
# Playwright 模拟上游服务端口；需与 E2E_PORT 不同。
# E2E_FIXTURE_PORT=4174
