# 浏览器访问端口（容器内部固定使用 3000）
PORT=3000
# 局域网访问保留 0.0.0.0；仅本机访问改为 127.0.0.1
HOST_BIND=0.0.0.0
# 使用 TUN/Fake-IP DNS 的环境可配置真实公网解析，通常留空即可。
# DNS_OVER_HTTPS_URL=https://1.1.1.1/dns-query
DNS_OVER_HTTPS_URL=
# 可选 Bangumi ECH 通道，仅用于 api.bgm.tv、next.bgm.tv、lain.bgm.tv。
# Docker 已内置工具；本地开发先运行 npm run build:ech（需要 Go >= 1.23）。
BANGUMI_ECH=false
ECH_DOH_URL=https://1.1.1.1/dns-query
# 动态片源使用服务端 Chromium 解析，可关闭以仅使用快速解析和网页播放器。
DYNAMIC_RESOLVER=true
DYNAMIC_RESOLVER_TIMEOUT_MS=20000
DYNAMIC_RESOLVER_CONCURRENCY=2
# 服务端视频缓存总容量（字节），默认 10 GiB，可在「下载缓存」中手动清理。
VIDEO_CACHE_MAX_BYTES=10737418240
