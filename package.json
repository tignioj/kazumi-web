{
  "name": "kazumi-web",
  "version": "1.0.6",
  "private": true,
  "description": "Kazumi 的 Web 移植版，支持 Docker Compose 部署",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "build:ech": "node scripts/build-ech.mjs",
    "check:ech": "node --env-file-if-exists=.env scripts/check-ech.mjs",
    "metadata:update": "node --env-file-if-exists=.env scripts/update-metadata.mjs",
    "start": "node server/index.js",
    "test": "node --test \"test/{frontend,server,shared,compatibility}/**/*.test.js\"",
    "test:frontend": "node --test \"test/frontend/**/*.test.js\"",
    "test:server": "node --test \"test/server/**/*.test.js\"",
    "test:shared": "node --test \"test/shared/**/*.test.js\"",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "build:hls": "node scripts/build-hls.mjs",
    "test:compat": "node --test test/compatibility/*.test.js",
    "compare:engines": "node scripts/compare-rule-engines.mjs",
    "compare:browser-engines": "node scripts/compare-browser-engines.mjs",
    "test:compat:browser": "node scripts/compare-browser-engines.mjs --local-only",
    "benchmark:runtime": "node scripts/benchmark-rule-runtime.mjs"
  },
  "dependencies": {
    "artplayer": "5.4.0",
    "express": "5.2.1",
    "hls.js": "1.7.3",
    "ipaddr.js": "2.5.0",
    "jsdom": "30.1.1",
    "jsonpath-plus": "11.1.1",
    "lucide-react": "1.51.0",
    "mp4box": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socks": "2.8.10",
    "undici": "8.11.2",
    "yauzl": "3.4.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "vite": "8.3.2"
  }
}
