{
  "name": "kazumi-web",
  "version": "1.0.0",
  "private": true,
  "description": "Kazumi 的 Web 移植版，支持 Docker Compose 部署",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "build:ech": "node scripts/build-ech.mjs",
    "check:ech": "node --env-file-if-exists=.env scripts/check-ech.mjs",
    "start": "node server/index.js",
    "test": "node --test server/test/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "5.2.1",
    "hls.js": "1.7.3",
    "ipaddr.js": "2.5.0",
    "jsdom": "30.1.1",
    "jsonpath-plus": "11.1.1",
    "lucide-react": "1.51.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "vite": "8.3.2"
  }
}
